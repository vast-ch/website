---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { getDictionary, route } from '~/i18n';

// Served for every missing URL, so it speaks both languages.
const en = getDictionary('en');
const fr = getDictionary('fr');
---

<SiteLayout
  locale="en"
  variant="home"
  title={en.notFound.meta.title}
  description={en.notFound.meta.description}
  noindex
>
  <section class="lost">
    <p class="mono muted">404</p>
    <h1>
      {en.notFound.heading}<br />
      <span lang="fr" class="muted">{fr.notFound.heading}</span>
    </h1>
    <div class="home-links mono">
      <a class="arrow-link" href={route('home', 'en')}>{en.notFound.back} <span aria-hidden="true">→</span></a>
      <a class="arrow-link" href={route('home', 'fr')} lang="fr">{fr.notFound.back} <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</SiteLayout>
