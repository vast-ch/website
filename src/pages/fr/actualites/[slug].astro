---
import NewsPostView from '~/components/views/NewsPostView.astro';
import { getPosts, postSlug, type Post } from '~/news';

export async function getStaticPaths() {
  const posts = await getPosts('fr');
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<NewsPostView locale="fr" post={post} />
