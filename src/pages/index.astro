---
import Layout from '~/layouts/PageLayout.astro';
import HeroOverlay from '~/components/widgets/HeroOverlay.astro';
import ServicesShowcase from '~/components/widgets/ServicesShowcase.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'index');
if (!page) throw new Error('Missing page entry: index');
const { metadata, hero, services, whyUs, caseStudies, cta } = page.data as Required<typeof page.data>;
---

<Layout metadata={metadata}>
  <HeroOverlay
    fullScreen
    title={hero.title}
    titleAccent={hero.titleAccent}
    subtitle={hero.subtitle}
    actions={hero.actions}
    image={{ src: '~/assets/images/index/index-hero.jpeg', alt: hero.imageAlt }}
  />

  <ServicesShowcase id={services.id} tagline={services.tagline} title={services.title} items={services.items} />

  <Content
    isReversed={whyUs.isReversed}
    items={whyUs.items}
    image={whyUs.image}
    imageMatchHeight
  >
    <Fragment slot="content">
      {whyUs.contentTagline && <p class="text-base text-secondary font-bold tracking-wide uppercase">{whyUs.contentTagline}</p>}
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">{whyUs.contentHeading}</h3>
      {whyUs.contentBody}
    </Fragment>
    {
      whyUs.accentBackground && (
        <Fragment slot="bg">
          <div class="absolute inset-0 bg-gray-100 dark:bg-transparent" />
        </Fragment>
      )
    }
  </Content>

  <CallToAction isBanner actions={cta.actions} title={cta.title} subtitle={cta.subtitle} />
</Layout>
