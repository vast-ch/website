---
import Pictogram from './Pictogram.astro';
import RealmSwitch from './RealmSwitch.astro';
import { EXTERNAL_LINKS, route, type Dictionary, type RouteKey } from '~/i18n';

export interface Props {
  t: Dictionary;
  current?: RouteKey;
}

const { t, current } = Astro.props;
const earth = current === 'earth';
// 'approach' is commented out while the approach page is hidden (see src/pages/_approach.astro).
const pages: RouteKey[] = ['services', /* 'approach', */ 'about', 'contact'];
---

<!--
  The mark on the left, the .ch / .earth switch in the middle, and on the right
  the pages of the side you are on: the vast.ch pages, or, on vast.earth (a
  single page for now), joining the association on its Discord. On phones the
  links fold behind a menu button.
-->
<header class="site-header">
  <a class="brand-mark" href={route('home', t.locale)}>
    <Pictogram title={`vast — ${t.nav.home}`} />
  </a>

  <RealmSwitch t={t} earth={earth} />

  <nav class="menu mono reveal" style="--reveal: 3" aria-label={t.chrome.primaryNav} data-menu>
    <button
      class="chrome-button menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-list"
      data-menu-toggle
      data-label-open={t.chrome.menu}
      data-label-close={t.chrome.close}
    >
      {t.chrome.menu}
    </button>

    <ul class="menu-group" id="menu-list">
      {
        earth ? (
          <li>
            <a class="chrome-link" href={EXTERNAL_LINKS.discord} target="_blank" rel="noopener noreferrer">
              {t.nav.join}
            </a>
          </li>
        ) : (
          pages.map((key) => (
            <li>
              <a class="chrome-link" href={route(key, t.locale)} aria-current={current === key ? 'page' : undefined}>
                {t.nav[key]}
              </a>
            </li>
          ))
        )
      }
    </ul>
  </nav>
</header>
