---
import Pictogram from './Pictogram.astro';
import RealmSwitch from './RealmSwitch.astro';
import { route, type Dictionary, type RouteKey } from '~/i18n';

export interface Props {
  t: Dictionary;
  current?: RouteKey;
}

const { t, current } = Astro.props;
const earth = current === 'earth';
// 'approach' is commented out while the approach page is hidden (see src/pages/_approach.astro).
const pages: RouteKey[] = ['services', /* 'approach', */ 'about', 'contact'];
---

<!--
  Left, which vast: the mark and the .ch / .earth switch, which reads as
  "vast.ch" or "vast.earth" and stays put on both sides. Right, where to go on
  this side: the vast.ch pages, or, on vast.earth (a single page for now), a
  link to joining the association.
-->
<header class="site-header">
  <div class="header-start">
    <a class="brand-mark" href={route('home', t.locale)}>
      <Pictogram title={`vast — ${t.nav.home}`} />
    </a>
    <RealmSwitch t={t} earth={earth} />
  </div>

  <nav class="menu mono reveal" style="--reveal: 3" aria-label={t.chrome.primaryNav}>
    <ul class="menu-group">
      {
        earth ? (
          <li>
            <a class="chrome-link" href={`${route('earth', t.locale)}#join`}>
              {t.earth.join.title}
            </a>
          </li>
        ) : (
          pages.map((key) => (
            <li>
              <a class="chrome-link" href={route(key, t.locale)} aria-current={current === key ? 'page' : undefined}>
                {t.nav[key]}
              </a>
            </li>
          ))
        )
      }
    </ul>
  </nav>
</header>
