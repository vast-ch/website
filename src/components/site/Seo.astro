---
import type { ImageMetadata } from 'astro';
import { HTML_LANG, LOCALES, OG_LOCALE, type Locale } from '~/i18n';

const SITE_NAME = 'vast.ch';
const TITLE_TEMPLATE = '%s — vast';

export interface Props {
  title: string;
  description: string;
  /** Use the title as is, without the " — vast" suffix (home page). */
  ignoreTitleTemplate?: boolean;
  noindex?: boolean;
  locale: Locale;
  /** The same page in every locale, for hreflang. Omit on pages without translations. */
  alternates?: Record<Locale, string>;
  /** Social preview card, 1200×630. */
  image: ImageMetadata;
}

const { title, description, ignoreTitleTemplate, noindex, locale, alternates, image } = Astro.props;

// Absolute URL without a trailing slash, matching `trailingSlash: 'never'`.
const absolute = (path: string) => new URL(path, Astro.site).href.replace(/\/$/, '');

const fullTitle = ignoreTitleTemplate ? title : TITLE_TEMPLATE.replace('%s', title);
const canonical = absolute(Astro.url.pathname);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

{
  alternates && (
    <>
      {LOCALES.map((l) => (
        <link rel="alternate" hreflang={HTML_LANG[l]} href={absolute(alternates[l])} />
      ))}
      <link rel="alternate" hreflang="x-default" href={absolute(alternates.en)} />
    </>
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
<meta property="og:image" content={absolute(image.src)} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />
<meta property="og:image:alt" content={fullTitle} />
<meta name="twitter:card" content="summary_large_image" />
