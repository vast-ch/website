---
import { LOCALES, route, type Dictionary, type Locale, type RouteKey } from '~/i18n';

export interface Props {
  t: Dictionary;
  /** The same page in every locale, for the language switch. */
  alternates: Record<Locale, string>;
  current?: RouteKey;
}

const { t, alternates, current } = Astro.props;
// On vast.earth the footer names the association; on vast.ch, the company,
// with a link to the legal notice.
const earth = current === 'earth';
---

<footer class="site-footer mono">
  {
    earth ? (
      <span class="realm-owner reveal" style="--reveal: 4">
        {t.chrome.association}
      </span>
    ) : (
      <a class="chrome-link realm-owner reveal" style="--reveal: 4" href={route('legal', t.locale)} title={t.nav.legal}>
        {t.chrome.company}
      </a>
    )
  }

  <div class="footer-controls">
    <nav class="lang-switch" aria-label={t.chrome.language}>
      {
        LOCALES.map((locale) => (
          <a
            class="chrome-link"
            href={alternates[locale]}
            hreflang={locale}
            lang={locale}
            title={t.chrome.languageNames[locale]}
            aria-current={locale === t.locale ? 'true' : undefined}
            data-lang={locale}
          >
            {locale.toUpperCase()}
          </a>
        ))
      }
    </nav>

    <button
      class="chrome-button"
      type="button"
      data-theme-toggle
      data-labels={JSON.stringify(t.chrome.theme)}
      aria-label={`${t.chrome.theme.label}: ${t.chrome.theme.auto}`}
    >
      <span data-theme-label>{t.chrome.theme.auto}</span>
    </button>
  </div>
</footer>
