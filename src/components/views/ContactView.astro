---
import SiteLayout from '~/layouts/SiteLayout.astro';
import { CONTACT_EMAIL, EXTERNAL_LINKS, getDictionary, mailto, route, type Locale } from '~/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const c = t.contact;
---

<SiteLayout locale={locale} page="contact" title={c.meta.title} description={c.meta.description}>
  <article class="content-surface">
    <div class="copy">
      <p class="eyebrow mono">{c.label}</p>
      <h1 class="page-heading">{c.heading}</h1>
      <p class="lead" set:html={c.intro} />
      <p class="contact-email">
        <span class="mono muted">{c.emailLabel}</span>
        <a class="email-link" href={mailto()}>{CONTACT_EMAIL}</a>
      </p>
    </div>

    <section class="contact-offers" aria-labelledby="contact-offers-label">
      <h2 id="contact-offers-label" class="eyebrow mono">{c.offersLabel}</h2>
      <ul class="offer-starts">
        {
          t.services.offers.map((offer) => (
            <li>
              <a class="offer-title" href={`${route('services', locale)}#${offer.id}`}>
                {offer.title}
              </a>
              <p>{offer.cta}</p>
              <a class="arrow-link mono" href={mailto(offer.title)}>
                {c.write} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="details-grid">
      <div>
        <span class="mono">{c.addressLabel}</span>
        <address>
          {
            c.address.map((line) => (
              <>
                {line}
                <br />
              </>
            ))
          }
        </address>
      </div>
      <div>
        <span class="mono">{c.elsewhereLabel}</span>
        <ul>
          <li>
            <a href={EXTERNAL_LINKS.linkedin} target="_blank" rel="noopener noreferrer">{t.nav.linkedin}</a>
          </li>
          <li>
            <a href={EXTERNAL_LINKS.github} target="_blank" rel="noopener noreferrer">{t.nav.github}</a>
          </li>
        </ul>
      </div>
    </div>

    <p class="small-print" set:html={c.smallPrint} />
  </article>
</SiteLayout>
