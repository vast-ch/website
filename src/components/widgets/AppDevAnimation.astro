---
/**
 * AppDevAnimation.astro — "one typed codebase" stepper visual for the
 * Application development service panel (What we do / ServicesShowcase).
 *
 * A 4-stage stepper — Concept → Prototype → Web & mobile → API. The full-width
 * top progress bar and arrow navigation come from the shared `mountStepper`
 * helper; this file builds the scenes and applies them in `onStage`.
 */
---

<div class="anim-root" data-appdev-anim>
  <div class="stage">
    <div class="card">
      <svg viewBox="0 0 1000 1414" preserveAspectRatio="xMidYMid meet" aria-hidden="true"></svg>
    </div>
  </div>

  <div class="controls">
    <button class="nav" data-prev type="button" aria-label="Previous step">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <span class="counter" data-counter>1 / 4</span>
    <button class="nav" data-next type="button" aria-label="Next step">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </button>
  </div>
</div>

<style>
  .anim-root {
    --ink: #0b0b0c;
    --muted: #6b6f76;
    --line: #e6e7ea;
    --fc: #3f7d5e;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 2%, 18px);
    height: 100%;
    width: 100%;
    padding: clamp(12px, 3%, 28px);
  }

  .stage {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card {
    position: relative;
    height: 100%;
    aspect-ratio: 1 / 1.414; /* portrait √2 (A-series) */
    max-width: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    box-shadow:
      0 1px 2px rgba(11, 11, 12, 0.04),
      0 18px 40px -24px rgba(11, 11, 12, 0.22);
  }
  .card svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .controls {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 1px solid var(--ink);
    background: #fff;
    color: var(--ink);
    border-radius: 999px;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      background 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }
  .nav svg {
    width: 22px;
    height: 22px;
    display: block;
  }
  .nav:hover:not(:disabled) {
    transform: translateY(-1px);
    background: var(--ink);
    color: #fff;
  }
  .nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .counter {
    min-width: 48px;
    text-align: center;
    color: var(--muted);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { animate } from 'motion';
  import { mountStepper } from './stepper';

  const NS = 'http://www.w3.org/2000/svg';
  const EASE = [0.2, 0.7, 0.2, 1];

  function buildAppDev(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';

    const svg = root.querySelector('svg');
    if (!svg) return;
    const el = (t: string, a: Record<string, any> = {}) => {
      const e = document.createElementNS(NS, t);
      for (const k in a) e.setAttribute(k, a[k]);
      return e;
    };
    const g = () => {
      const e = el('g') as SVGGElement;
      svg.appendChild(e);
      return e;
    };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ============ background ============ */
    const defs = el('defs');
    svg.appendChild(defs);
    defs.innerHTML = `
      <linearGradient id="ad-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f7f9fb"/><stop offset=".55" stop-color="#fdfdfe"/><stop offset="1" stop-color="#ffffff"/>
      </linearGradient>
      <radialGradient id="ad-glow" cx="50%" cy="30%" r="50%">
        <stop offset="0" stop-color="#eef3f0"/><stop offset="1" stop-color="#eef3f0" stop-opacity="0"/>
      </radialGradient>`;
    svg.appendChild(el('rect', { x: 0, y: 0, width: 1000, height: 1414, fill: 'url(#ad-sky)' }));
    svg.appendChild(el('rect', { x: 0, y: 0, width: 1000, height: 1414, fill: 'url(#ad-glow)' }));
    for (let y = 320; y < 1120; y += 64)
      for (let x = 80; x <= 920; x += 64) svg.appendChild(el('circle', { cx: x, cy: y, r: 1.3, fill: '#eceef0' }));

    /* ============ stage layers ============ */
    const BX = 110,
      BY = 360,
      BW = 560,
      BH = 470;

    // -- concept group: dashed frame + sketch scribbles --
    const gConcept = g();
    gConcept.appendChild(el('rect', { x: BX, y: BY, width: BW, height: BH, rx: 18, fill: '#fff', stroke: '#c5c9cf', 'stroke-width': 2.5, 'stroke-dasharray': '10 9' }));
    ['M170,470 q60,-30 120,0 t120,0', 'M170,560 h300', 'M170,620 h220', 'M170,690 q40,40 90,0 t90,0 t90,0', 'M170,760 h150'].forEach((d) =>
      gConcept.appendChild(el('path', { d, fill: 'none', stroke: '#b9bdc4', 'stroke-width': 4, 'stroke-linecap': 'round' }))
    );

    // -- browser group --
    const gBrowser = g();
    gBrowser.style.opacity = '0';
    gBrowser.appendChild(el('rect', { x: BX, y: BY, width: BW, height: BH, rx: 18, fill: '#fff', stroke: '#d7dadf', 'stroke-width': 2 }));
    gBrowser.appendChild(el('rect', { x: BX, y: BY, width: BW, height: 64, rx: 18, fill: '#f1f3f5' }));
    gBrowser.appendChild(el('rect', { x: BX, y: BY + 44, width: BW, height: 20, fill: '#f1f3f5' }));
    [140, 168, 196].forEach((cx) => gBrowser.appendChild(el('circle', { cx, cy: BY + 32, r: 7, fill: '#d2d6db' })));
    gBrowser.appendChild(el('rect', { x: 150, y: 460, width: 480, height: 34, rx: 8, fill: '#e7e9ec' }));
    gBrowser.appendChild(el('rect', { x: 150, y: 520, width: 230, height: 150, rx: 10, fill: '#eef0f2' }));
    gBrowser.appendChild(el('rect', { x: 400, y: 520, width: 230, height: 150, rx: 10, fill: '#eef0f2' }));
    const bBtn = el('rect', { x: 150, y: 700, width: 180, height: 46, rx: 11, fill: '#dfe2e6' });
    gBrowser.appendChild(bBtn);
    gBrowser.appendChild(el('rect', { x: 360, y: 710, width: 270, height: 14, rx: 7, fill: '#e7e9ec' }));
    gBrowser.appendChild(el('rect', { x: 360, y: 736, width: 200, height: 14, rx: 7, fill: '#eef0f2' }));

    // -- phone group (slides in from right) --
    const gPhone = g();
    gPhone.style.opacity = '0';
    gPhone.style.transform = 'translateX(240px)';
    const PX = 630,
      PY = 540,
      PW = 240,
      PH = 510;
    gPhone.appendChild(el('rect', { x: PX, y: PY, width: PW, height: PH, rx: 34, fill: '#fff', stroke: '#d2d6db', 'stroke-width': 2 }));
    gPhone.appendChild(el('rect', { x: PX + 90, y: PY + 18, width: 60, height: 14, rx: 7, fill: '#e7e9ec' }));
    gPhone.appendChild(el('rect', { x: PX + 24, y: PY + 60, width: PW - 48, height: 26, rx: 7, fill: '#e7e9ec' }));
    gPhone.appendChild(el('rect', { x: PX + 24, y: PY + 102, width: PW - 48, height: 118, rx: 10, fill: '#eef0f2' }));
    gPhone.appendChild(el('rect', { x: PX + 24, y: PY + 232, width: PW - 48, height: 86, rx: 10, fill: '#eef0f2' }));
    const pBtn = el('rect', { x: PX + 24, y: PY + 338, width: 130, height: 38, rx: 9, fill: '#dfe2e6' });
    gPhone.appendChild(pBtn);
    gPhone.appendChild(el('rect', { x: PX + 90, y: PY + 470, width: 60, height: 8, rx: 4, fill: '#e7e9ec' }));

    // -- API group --
    const gAPI = g();
    gAPI.style.opacity = '0';
    gAPI.style.transform = 'translateY(40px)';
    const connB = el('path', { d: 'M460,1150 C 440,1020 408,930 400,832', fill: 'none', stroke: '#c9ccd1', 'stroke-width': 2.5, 'stroke-linecap': 'round' }) as unknown as SVGPathElement;
    const connP = el('path', { d: 'M540,1150 C 600,1112 700,1092 748,1052', fill: 'none', stroke: '#c9ccd1', 'stroke-width': 2.5, 'stroke-linecap': 'round' }) as unknown as SVGPathElement;
    gAPI.appendChild(connB);
    gAPI.appendChild(connP);
    const SX = 394,
      SY = 1146,
      SW = 212,
      SH = 128;
    gAPI.appendChild(el('rect', { x: SX, y: SY, width: SW, height: SH, rx: 14, fill: '#0b0b0c' }));
    gAPI.appendChild(el('rect', { x: SX, y: SY + 16, width: 7, height: SH - 32, rx: 3, fill: 'var(--fc)' }));
    gAPI.appendChild(el('rect', { x: SX + 22, y: SY + 16, width: SW - 44, height: 34, rx: 8, fill: '#1b1d24' }));
    gAPI.appendChild(el('circle', { cx: SX + 44, cy: SY + 33, r: 5, fill: 'var(--fc)' }));
    gAPI.appendChild(el('circle', { cx: SX + 62, cy: SY + 33, r: 5, fill: '#3c3f48' }));
    [0, 1, 2].forEach((i) => gAPI.appendChild(el('rect', { x: SX + 118, y: SY + 24 + i * 7, width: 60, height: 3, rx: 1.5, fill: '#3c3f48' })));
    const pulses: { c: SVGCircleElement; path: SVGPathElement; off: number }[] = [];
    (
      [
        [connB, 0],
        [connB, 0.5],
        [connP, 0.0],
        [connP, 0.5],
      ] as [SVGPathElement, number][]
    ).forEach(([path, off]) => {
      const c = el('circle', { r: 6, fill: 'var(--fc)', opacity: 0 }) as unknown as SVGCircleElement;
      svg.appendChild(c);
      pulses.push({ c, path, off });
    });

    /* ============ scene application ============ */
    const set = (e: any, kf: Record<string, any>) => {
      for (const k in kf) {
        const v = kf[k];
        if (k === 'fill' || k === 'stroke') e.setAttribute(k, v);
        else if (k === 'x') e.style.transform = `translateX(${v}px)`;
        else if (k === 'y') e.style.transform = `translateY(${v}px)`;
        else e.style[k] = v;
      }
    };
    const commit = (t: any, kf: Record<string, any>) => (Array.isArray(t) ? t : [t]).forEach((e) => set(e, kf));
    const A = reduce
      ? null
      : (t: any, kf: Record<string, any>, o: any) => {
          const a = animate(t, kf, o);
          a.finished.then(() => commit(t, kf)).catch(() => {});
          return a;
        };

    function targetsFor(s: number): [any, Record<string, any>][] {
      const live = s >= 3 ? '#3f7d5e' : '#dfe2e6';
      return [
        [gConcept, { opacity: s === 0 ? 1 : 0 }],
        [gBrowser, { opacity: s >= 1 ? 1 : 0 }],
        [gPhone, { opacity: s >= 2 ? 1 : 0, x: s >= 2 ? 0 : 240 }],
        [gAPI, { opacity: s >= 3 ? 1 : 0, y: s >= 3 ? 0 : 40 }],
        [bBtn, { fill: live }],
        [pBtn, { fill: live }],
      ];
    }

    let flowing = false;

    mountStepper({
      root,
      svg,
      steps: ['Conception', 'Prototyping', 'Web & mobile development', 'Backend development'],
      reduce,
      onStage: (s, _prev, anim) => {
        targetsFor(s).forEach(([e, kf]) => {
          if (anim && A) {
            try {
              A(e, kf, { duration: 0.5, ease: EASE });
            } catch {
              set(e, kf);
            }
          } else {
            set(e, kf);
          }
        });
        flowing = s >= 3;
      },
    });

    // looping data pulses (API stage only) — self-contained rAF loop, gated by `flowing`
    if (!reduce) {
      const PERIOD = 1500;
      requestAnimationFrame(function frame(now) {
        for (let i = 0; i < pulses.length; i++) {
          const pu = pulses[i];
          if (!flowing) {
            pu.c.setAttribute('opacity', '0');
            continue;
          }
          const t = ((now + i * 270 + pu.off * PERIOD) % PERIOD) / PERIOD;
          const L = pu.path.getTotalLength(),
            pt = pu.path.getPointAtLength(L * t);
          pu.c.setAttribute('cx', String(pt.x));
          pu.c.setAttribute('cy', String(pt.y));
          pu.c.setAttribute('opacity', Math.sin(Math.PI * t).toFixed(3));
        }
        requestAnimationFrame(frame);
      });
    }
  }

  const init = () => document.querySelectorAll<HTMLElement>('[data-appdev-anim]').forEach(buildAppDev);
  init();
  document.addEventListener('astro:page-load', init);
</script>
