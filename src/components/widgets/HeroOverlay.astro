---
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';

import type { Hero as HeroProps } from '~/types';

interface Props extends HeroProps {
  titleAccent?: string;
  // Home hero fills the viewport; inner-page heroes size to their content.
  fullScreen?: boolean;
}

// Contained rounded image banner with the title, subtitle and call-to-action
// centred over it. Used on the home page (full-screen) and on every inner-page
// hero (content height). The banner sits inside a `max-w-7xl px-4 md:px-6`
// container so its width matches the other sections.
const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  titleAccent,
  actions = [],
  image = await Astro.slots.render('image'),
  fullScreen = false,

  id,
} = Astro.props;

// CTAs reuse the site's standard button utilities so they match the buttons used
// elsewhere on the page; the light scrim over the image keeps their dark text/fill
// legible. `w-full sm:w-auto` preserves the full-width stacked layout on mobile.
const primaryClass = 'btn-primary w-full sm:w-auto';
const secondaryClass = 'btn-secondary w-full sm:w-auto';
---

<section
  class:list={[
    'relative not-prose pt-4 pb-12 md:pt-6 md:pb-16 lg:pb-20',
    fullScreen && 'h-[100svh] min-h-[600px] max-h-[1024px]',
  ]}
  {...id ? { id } : {}}
>
  <div class:list={['relative mx-auto max-w-7xl px-4 md:px-6', fullScreen && 'h-full']}>
    <div class:list={['relative overflow-hidden rounded-2xl shadow-lg', fullScreen && 'h-full']}>
      {
        image &&
          (typeof image === 'string' ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="absolute inset-0 h-full w-full object-cover"
              style="object-position: center 50%;"
              layout="cover"
              widths={[400, 768, 1024, 2040]}
              sizes="(max-width: 1280px) 100vw, 1280px"
              loading="eager"
              fetchpriority="high"
              {/* Keep the source 3:4 aspect (3024x4032) so the CDN doesn't center-crop it to
                  landscape; object-fit: cover + object-position frame it per viewport instead. */}
              width={1280}
              height={1707}
              format="webp"
              {...image}
            />
          ))
      }

      <div class="absolute inset-0 bg-gradient-to-b from-white/40 via-white/75 to-white/60" aria-hidden="true"></div>

      <div
        class:list={[
          'relative z-10 mx-auto flex max-w-4xl flex-col items-center justify-center px-6 py-16 text-center',
          fullScreen ? 'h-full' : 'min-h-[24rem] md:min-h-[28rem]',
        ]}
      >
        {tagline && <p class="mb-4 text-base font-bold uppercase tracking-wide text-black/80" set:html={tagline} />}
        {
          title && (
            <h1 class="mb-4 font-heading text-4xl font-bold leading-tighter tracking-tighter text-black sm:text-5xl md:text-6xl">
              <Fragment set:html={title} />
              {titleAccent && <span class="text-black/80">{' '}{titleAccent}</span>}
            </h1>
          )
        }
        {subtitle && <p class="mb-8 max-w-2xl text-lg text-gray-700 sm:text-xl" set:html={subtitle} />}
        {
          Array.isArray(actions) && actions.length > 0 && (
            <div class="flex w-full max-w-xs flex-col gap-4 sm:max-w-md sm:flex-row sm:justify-center">
              {actions.map((action) => (
                <a
                  href={action.href}
                  class={action.variant === 'primary' ? primaryClass : secondaryClass}
                  {...(action.target ? { target: action.target, rel: 'noopener noreferrer' } : {})}
                >
                  <Fragment set:html={action.text} />
                  {action.icon && <Icon name={action.icon} class="-mr-1 ml-1 inline-block h-5 w-5" />}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
