---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Image from '~/components/common/Image.astro';
import { CASE_STUDY_SERVICES, CASE_STUDY_INDUSTRIES, TAXONOMY_LABELS } from '~/utils/case-studies';

interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  caseStudies: Array<CollectionEntry<'case-studies'>>;
  id?: string;
}

const { title, subtitle, tagline, caseStudies = [], id } = Astro.props;

const tagsOf = (cs: CollectionEntry<'case-studies'>): string[] => [...cs.data.services, ...cs.data.industries];

// Only offer filters that match at least one case study.
const isUsed = (slug: string): boolean => caseStudies.some((cs) => tagsOf(cs).includes(slug));

// `small-tools` and `advisory` remain valid taxonomy (and still show as card
// tags), but are intentionally omitted from the Services filter pills.
const EXCLUDED_SERVICE_FILTERS = new Set<string>(['small-tools', 'advisory']);

// Filters grouped by category — labelled and rendered as separate blocks.
const serviceFilters = CASE_STUDY_SERVICES.filter((slug) => !EXCLUDED_SERVICE_FILTERS.has(slug) && isUsed(slug)).map(
  (slug) => ({ slug, label: TAXONOMY_LABELS[slug] })
);
const industryFilters = CASE_STUDY_INDUSTRIES.filter((slug) => isUsed(slug)).map((slug) => ({
  slug,
  label: TAXONOMY_LABELS[slug],
}));

const checkboxLabelClass = 'flex cursor-pointer items-center gap-2.5 text-sm leading-tight';
const checkboxClass = 'h-4 w-4 shrink-0 cursor-pointer accent-primary';
---

<WidgetWrapper id={id} containerClass="max-w-7xl mx-auto">
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div class="flex flex-col gap-8 lg:flex-row lg:items-start">
    {
      (serviceFilters.length > 0 || industryFilters.length > 0) && (
        <aside
          class="lg:sticky lg:top-24 lg:w-64 lg:shrink-0"
          role="group"
          aria-label="Filter case studies"
          data-cs-filters
        >
          <div class="rounded-lg border border-gray-200 bg-section p-6 dark:border-slate-700">
            <h2 class="mb-5 border-b border-gray-200 pb-3 text-lg font-bold dark:border-slate-700">Filters</h2>
            <div class="flex flex-col gap-6 sm:flex-row sm:flex-wrap sm:gap-x-12 lg:flex-col lg:gap-6">
              {serviceFilters.length > 0 && (
                <div class="flex flex-col items-start gap-3">
                  <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">Services</h3>
                  <div class="flex flex-col gap-2.5">
                    {serviceFilters.map(({ slug, label }) => (
                      <label class={checkboxLabelClass}>
                        <input type="checkbox" data-filter={slug} class={checkboxClass} />
                        <span>{label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              )}
              {industryFilters.length > 0 && (
                <div class="flex flex-col items-start gap-3">
                  <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">Industries</h3>
                  <div class="flex flex-col gap-2.5">
                    {industryFilters.map(({ slug, label }) => (
                      <label class={checkboxLabelClass}>
                        <input type="checkbox" data-filter={slug} class={checkboxClass} />
                        <span>{label}</span>
                      </label>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        </aside>
      )
    }

    <div class="min-w-0 flex-1">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:gap-6 xl:grid-cols-3" data-cs-grid>
        {
          caseStudies.map((cs) => (
            <article
              class="group relative flex flex-col overflow-hidden rounded-lg border border-[#ffffff29] bg-white shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur dark:bg-slate-900 dark:shadow-[0_4px_30px_rgba(0,0,0,0.1)]"
              data-cs-card
              data-tags={tagsOf(cs).join(' ')}
            >
              <a
                href={`#${cs.id}`}
                data-cs-open={cs.id}
                aria-haspopup="dialog"
                class="flex flex-1 cursor-pointer flex-col focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary"
              >
                {cs.data.image && (
                  <Image
                    class="w-full"
                    width={600}
                    height={338}
                    widths={[400, 768]}
                    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                    layout="responsive"
                    format="webp"
                    {...cs.data.image}
                  />
                )}
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-xl font-bold">{cs.data.title}</h3>
                  {cs.data.client && <p class="mt-1 text-sm text-muted">{cs.data.client}</p>}
                  <p class="mt-2 text-muted" set:html={cs.data.excerpt} />
                  <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-medium text-primary">
                    Details
                    <Icon
                      name="tabler:chevron-right"
                      class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
                    />
                  </span>
                </div>
              </a>

              <dialog
                id={cs.id}
                data-cs-modal
                aria-labelledby={`${cs.id}-title`}
                class="m-auto w-[calc(100vw-2rem)] max-w-2xl overflow-hidden rounded-lg border-0 bg-white p-0 text-default shadow-2xl dark:bg-slate-900 dark:text-slate-200"
              >
                <button
                  type="button"
                  data-cs-close
                  aria-label="Close"
                  class="absolute right-3 top-3 z-10 flex h-9 w-9 items-center justify-center rounded-full bg-white/80 backdrop-blur transition hover:bg-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:bg-slate-800/80 dark:hover:bg-slate-700"
                >
                  <Icon name="tabler:x" class="h-5 w-5" />
                </button>

                <div class="max-h-[85dvh] overflow-y-auto">
                  {cs.data.image && (
                    <Image
                      class="w-full"
                      width={672}
                      height={378}
                      widths={[400, 768]}
                      sizes="(max-width: 768px) 100vw, 672px"
                      layout="responsive"
                      format="webp"
                      {...cs.data.image}
                    />
                  )}

                  <div class="p-6 sm:p-8">
                    <div class="flex flex-wrap gap-2">
                      {tagsOf(cs).map((slug) => (
                        <span class="inline-block rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                          {TAXONOMY_LABELS[slug as keyof typeof TAXONOMY_LABELS]}
                        </span>
                      ))}
                    </div>
                    <h3 id={`${cs.id}-title`} class="mt-3 text-2xl font-bold">
                      {cs.data.title}
                    </h3>
                    {cs.data.client && <p class="mt-1 text-sm text-muted">{cs.data.client}</p>}
                    <p class="mt-3 text-muted" set:html={cs.data.excerpt} />

                    <div class="mt-6 space-y-6 border-t border-gray-200 pt-6 dark:border-slate-700">
                      {cs.data.items.map(({ title: itemTitle, description, icon }) => (
                        <div class="flex flex-row max-w-none">
                          <div class="flex justify-center">
                            <Icon
                              name={icon || 'tabler:check'}
                              class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-white dark:text-black p-1 mr-2 rtl:mr-0 rtl:ml-2"
                            />
                          </div>
                          <div class="mt-0.5">
                            {itemTitle && (
                              <h4 class="text-lg font-semibold leading-6 dark:text-white ml-2 rtl:ml-0 rtl:mr-2">
                                {itemTitle}
                              </h4>
                            )}
                            {description && (
                              <p
                                class="mt-3 text-muted dark:text-slate-400 ml-2 rtl:ml-0 rtl:mr-2"
                                set:html={description}
                              />
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </dialog>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</WidgetWrapper>

<script>
  function initCaseStudyFilters() {
    const root = document.querySelector<HTMLElement>('[data-cs-filters]');
    if (!root) return;
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('input[type="checkbox"][data-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-cs-card]'));

    // Multiple boxes can be checked at once. A card is shown when it matches any
    // checked filter; when none are checked, every card is shown.
    const apply = () => {
      const active = boxes.filter((b) => b.checked).map((b) => b.dataset.filter ?? '');
      cards.forEach((card) => {
        const tags = (card.dataset.tags ?? '').split(' ');
        card.classList.toggle('hidden', active.length > 0 && !active.some((slug) => tags.includes(slug)));
      });
    };

    boxes.forEach((box) => box.addEventListener('change', apply));

    // Re-sync in case the browser restored checkbox states (back/forward nav).
    apply();
  }

  // Opens a case study in its modal dialog and locks background scrolling.
  function openCaseStudyModal(id: string) {
    const dialog = document.getElementById(id);
    if (!(dialog instanceof HTMLDialogElement) || !dialog.hasAttribute('data-cs-modal') || dialog.open) return;
    dialog.showModal();
    document.documentElement.style.overflow = 'hidden';
  }

  function initCaseStudyModals() {
    const openers = Array.from(document.querySelectorAll<HTMLElement>('[data-cs-open]'));
    const dialogs = Array.from(document.querySelectorAll<HTMLDialogElement>('dialog[data-cs-modal]'));

    openers.forEach((opener) => {
      opener.addEventListener('click', (event) => {
        event.preventDefault();
        openCaseStudyModal(opener.dataset.csOpen ?? '');
      });
    });

    dialogs.forEach((dialog) => {
      // Close button inside the modal.
      dialog
        .querySelectorAll<HTMLElement>('[data-cs-close]')
        .forEach((btn) => btn.addEventListener('click', () => dialog.close()));
      // A click on the backdrop (the dialog itself, not the panel) closes it.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
      // Restore scrolling whenever the dialog closes (button, Esc, or backdrop).
      dialog.addEventListener('close', () => {
        document.documentElement.style.overflow = '';
      });
    });
  }

  // Deep links (e.g. /case-studies#flightbook) open that case study's modal.
  function openCaseStudyFromHash() {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (id) openCaseStudyModal(id);
  }

  // Runs on first load and after every view transition (ClientRouter).
  document.addEventListener('astro:page-load', () => {
    initCaseStudyFilters();
    initCaseStudyModals();
    openCaseStudyFromHash();
  });
  window.addEventListener('hashchange', openCaseStudyFromHash);
</script>

<style>
  dialog[data-cs-modal]::backdrop {
    background-color: rgb(0 0 0 / 55%);
    backdrop-filter: blur(2px);
  }

  @media (prefers-reduced-motion: no-preference) {
    dialog[data-cs-modal][open] {
      animation: cs-modal-in 0.2s ease-out;
    }
    dialog[data-cs-modal][open]::backdrop {
      animation: cs-backdrop-in 0.2s ease-out;
    }
  }

  @keyframes cs-modal-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
  }

  @keyframes cs-backdrop-in {
    from {
      background-color: rgb(0 0 0 / 0%);
    }
  }
</style>
