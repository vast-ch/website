---
import SiteLayout from '~/layouts/SiteLayout.astro';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;
---

<SiteLayout locale="en" title={frontmatter?.title ?? ''}>
  <article class="content-surface copy markdown">
    <h1 class="page-heading">{frontmatter.title}</h1>
    <slot />
  </article>
</SiteLayout>
